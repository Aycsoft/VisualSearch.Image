VISUAL_SEARCH_API_KEY=replace-with-a-long-random-value
VISUAL_SEARCH_DEVICE=cpu
VISUAL_SEARCH_TORCH_THREADS=8
VISUAL_SEARCH_STORE_BACKEND=sqlite
VISUAL_SEARCH_SQLITE_PATH=/var/lib/crosscart/visual-search/visual-search.db
VISUAL_SEARCH_CATALOG_ROOT=/var/lib/crosscart/upload
VISUAL_SEARCH_CATALOG_ROOTS=/var/lib/crosscart/upload
VISUAL_SEARCH_MODEL_ID=facebook/dinov2-base
VISUAL_SEARCH_MODEL_VERSION=dinov2-base-v1
VISUAL_SEARCH_PUBLIC_IMAGE_BASE_URL=/v1/catalog/image?path=
HF_HOME=/var/lib/crosscart/visual-search/models
PYTHONPATH=/opt/crosscart/visual-search/service
