VISUAL_SEARCH_API_KEY=replace-with-a-long-random-value
VISUAL_SEARCH_MODEL_ID=facebook/dinov2-base
VISUAL_SEARCH_MODEL_REVISION=main
VISUAL_SEARCH_MODEL_VERSION=dinov2-base-v1
VISUAL_SEARCH_DEVICE=auto
VISUAL_SEARCH_QDRANT_URL=http://qdrant:6333
VISUAL_SEARCH_STORE_BACKEND=sqlite
VISUAL_SEARCH_SQLITE_PATH=/data/visual-search.db
VISUAL_SEARCH_COLLECTION_PREFIX=product_images
VISUAL_SEARCH_HIGH_CONFIDENCE_SCORE=0.82
VISUAL_SEARCH_MEDIUM_CONFIDENCE_SCORE=0.70
VISUAL_SEARCH_CATALOG_ROOT=/catalog
VISUAL_SEARCH_PUBLIC_IMAGE_BASE_URL=/api/visual-search/demo/image?path=
